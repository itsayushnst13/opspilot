# Copy to .env (never commit .env). All values below are safe placeholders.

# --- Core ---
ENV=dev                                   # dev | prod (prod refuses to start with the default JWT secret)
DATABASE_URL=sqlite:///./opspilot.db      # e.g. postgresql://user:pass@host/db?sslmode=require (Neon/Supabase/Render all work)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRE_MINUTES=480

# --- Demo users (analyst@/approver@/admin@opspilot.demo) ---
DEMO_PASSWORD=opspilot-demo               # set your own for any shared deployment
EXPOSE_DEMO_USERS=true                    # shows one-click demo logins on the login page; set false for a private deployment
ALLOW_SELF_APPROVAL=false                 # four-eyes rule: the creator of a quote cannot approve it

# --- AI (optional). Without a key the app runs in deterministic "rules" mode. ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash           # measured ~2 s vs ~8-76 s for gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-2.5-flash   # tried in order if the model above is reported as not found
# GEMINI_TEMPERATURE=                    # unset = model default (recommended for Gemini 3); e.g. 0 for 2.x models
GEMINI_THINKING_LEVEL=minimal            # measured 1.4 s / 9 tokens vs 1.8 s / 99 tokens at the default
GEMINI_EMBED_MODEL=gemini-embedding-001
LLM_MODE=auto                             # auto (use Gemini if a key is set) | llm | rules
# LLM_TIMEOUT_S=60                        # per HTTP request
# LLM_TOTAL_BUDGET_S=90                   # whole call: retries across every fallback model

# --- Limits ---
MAX_UPLOAD_MB=5
MAX_PDF_PAGES=30

# --- Demo stability ---
# The synthetic price lists are valid until 2027-03-31. Pin "today" so a long-lived public demo keeps working.
# Leave empty to use the real date.
REFERENCE_DATE=2026-10-01

# --- Serving ---
CORS_ORIGINS=http://localhost:5173        # comma-separated; only needed if the frontend is hosted on another origin
STORAGE_DIR=./storage
# STATIC_DIR=../frontend/dist             # set to serve the built frontend from FastAPI (the Dockerfile does this)

# --- Frontend build-time (only when the UI is hosted separately, e.g. Vercel) ---
# VITE_API_URL=https://your-api.onrender.com
